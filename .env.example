# Relay server (server/relay.mjs) for the Meta Muse provider. Copy to .env and `npm run relay`.

# Meta Model API key from https://dev.meta.ai (also accepted as MODEL_API_KEY)
META_API_KEY=

# Models (defaults shown)
MUSE_MODEL=muse-spark-1.3
MUSE_ASR_MODEL=muse-voice-transcribe-1.0

# Voice. Meta has no text-to-speech on the API yet, so pick one:
#   elevenlabs  - ElevenLabs streaming TTS (needs ELEVENLABS_API_KEY)
#   custom      - POST {text, sampleRate} to TTS_URL, expects raw PCM16 mono 24 kHz back (slot for an internal voice)
#   none        - text only; the head thinks and logs but stays silent
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# TTS_URL=
# TTS_API_KEY=

# Persona file (defaults to config/persona.md) and port
# PERSONA=config/persona.md
# PORT=8787
